# Copiar a .env y completar con tus propias credenciales de Turso.
# Si se dejan vacías, la app usa un archivo SQLite local (server/db/inventory.db) — ideal para desarrollo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto para firmar los JWT de sesión. En producción, poner un valor propio y largo.
JWT_SECRET=
