# Copiar a .env y completar con tus propias credenciales de Turso.
# Si se dejan vacías, la app usa un archivo SQLite local (server/db/inventory.db) — ideal para desarrollo.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Secreto para firmar los JWT de sesión. En producción, poner un valor propio y largo.
JWT_SECRET=

# Correo(s) que pueden entrar al panel de administración (/admin) para confirmar
# las tiendas nuevas. Separados por comas si son varios. Por defecto: brianadmin@aldia.cu
ADMIN_EMAILS=

# Auditoría con IA. En 0 (o vacío) los cierres no se encolan y la app funciona
# exactamente igual que antes. Se activa con AUDIT_ENABLED=1.
AUDIT_ENABLED=

# Worker de auditoría: el cron externo llama /api/cron/audit con este secreto.
# En Vercel, definir CRON_SECRET y configurar el mismo valor en el cron.
CRON_SECRET=
GEMINI_API_KEY=
AUDIT_MODEL=
AUDIT_MAX_LLM_PER_DAY_PER_SHOP=
# Tiempo máximo que el worker dedica a reclamar trabajos nuevos por invocación.
AUDIT_WORKER_TIME_BUDGET_MS=30000
